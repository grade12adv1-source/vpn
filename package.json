{
  "name": "aero-vpn",
  "version": "0.1.0",
  "description": "A privacy-focused WireGuard desktop client with measured route latency",
  "private": true,
  "main": "desktop/main.cjs",
  "engines": { "node": ">=24" },
  "scripts": {
    "postinstall": "install-electron",
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
    "build": "electron-builder --dir --publish never",
    "dist": "electron-builder --publish never",
    "dist:win": "electron-builder --win portable --x64 --publish never",
    "dist:installer": "electron-builder --win nsis --x64 --publish never"
  },
  "devDependencies": {
    "electron": "44.7.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "app.aerovpn.desktop",
    "productName": "Aero VPN",
    "toolsets": { "wine": "1.0.1" },
    "directories": { "output": "dist" },
    "files": ["desktop/**", "ui/**", "package.json"],
    "linux": { "target": ["AppImage"], "category": "Network" },
    "mac": { "target": ["dmg"], "category": "public.app-category.utilities" },
    "win": { "target": ["portable"], "signExecutable": false, "icon": "ui/icon.ico" },
    "portable": { "artifactName": "Aero-VPN-${version}-win-${arch}.exe", "requestExecutionLevel": "user" },
    "nsis": { "oneClick": false, "perMachine": false, "allowToChangeInstallationDirectory": true }
  }
}
